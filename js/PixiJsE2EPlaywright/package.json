{
  "name": "pixijs-e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright E2E automation for the Pixi.js/Canvas demo game (testomut/pixijs-e2e-testing-demo).",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:video": "cross-env RECORD_VIDEO=true playwright test",
    "test:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.22.0"
  }
}
