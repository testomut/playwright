    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm tests"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.12.12",
    "dotenv": "^16.4.5",
    "typescript": "~6.0.3"
  }
