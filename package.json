{
  "name": "wikipedia-language-aqa",
  "version": "1.0.0",
  "description": "AQA test task: an authorised Wikipedia user switches the interface language in Preferences (Playwright + TypeScript, Docker).",
  "license": "MIT",
  "author": "Stanislav Mokshyn <https://github.com/testomut>",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
